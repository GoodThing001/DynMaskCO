+def current_document_context(relative, text):
+    """Separate lexical terms from actual current assertions; no scientific pass."""
+    assertions, nonassertive = [], []
+    for hit in scan_universal_wording(relative, text):
+        matched = list(hit['patterns'])
+        context = []
+        if 'unique_path' in matched and not hit['asserts_exhaustiveness']:
+            matched.remove('unique_path'); context.append('uniqueness_not_exhaustive_path_assertion')
+        if ('equivalence' in matched and re.search(
+                r'^\s*\|\s*(?:等价|等效)\s*\|\s*单独预声明', hit['excerpt'])):
+            matched.remove('equivalence'); context.append('requirements_table_not_equivalence_result')
+        if context:
+            nonassertive.append({**hit, 'nonassertive_context': context})
+        if matched:
+            assertions.append({**hit, 'patterns': matched})
+    return {'current_assertion_hits': assertions, 'lexical_terms_with_nonassertive_context': nonassertive,
+            'scope_only_lexical_review': True, 'scientific_qualification_established': False}
 
 
