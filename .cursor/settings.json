  },
  "search.exclude": {
    "**/*.ckpt": true,
    "**/*.npz": true,
    "**/*.npy": true,
    "**/*.pkl": true,
    "**/*.so": true,
    "**/*.pt": true,
    "**/*.pth": true,
    "**/__pycache__/**": true,
    "**/logs/**": true,
    "**/figs/**": true,
    "**/dist/**": true
  },
